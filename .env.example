# ===================================================================
# Code Nexus - Environment Variables Configuration
# Copy to .env and replace every blank/placeholder value locally.
# Never commit or distribute a populated .env file.
# ===================================================================

# 1. PostgreSQL database connection string (required; no fallback is provided)
# Local example format:
# DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/<db_name>
# Managed PostgreSQL should use TLS, for example ...?sslmode=require
DATABASE_URL=

# 2. Resend HTTPS API (required for real verification/password-reset email)
# Obtain a key at https://resend.com/api-keys and use a verified sender/domain.
RESEND_API_KEY=
EMAIL_FROM=

# 3. Canonical public application URL (required in production; use https://)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. JWT signing secret (required in production; minimum 32 characters)
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# 5. Optional local-only seed-account passwords for scripts/seed-users.js.
# Leave blank unless intentionally seeding local demo accounts. Never seed
# demo accounts into a public production database.
SEED_ADMIN_PASSWORD=
SEED_STUDENT_PASSWORD=

# 6. Reverse-proxy and source-archive controls
# Set TRUST_PROXY_HEADERS=true only behind a proxy that strips/sets
# X-Forwarded-For and X-Real-IP itself.
TRUST_PROXY_HEADERS=false
# The full source ZIP endpoint is disabled in production unless explicitly enabled.
ALLOW_SOURCE_DOWNLOAD=false

# 7. Sandboxed code execution
# Modes: "sandboxed_local" (bubblewrap + prlimit required) or "external".
CODE_RUNNER_MODE=sandboxed_local
# External mode requires an HTTPS service URL and API key in production.
CODE_EXECUTION_SERVICE_URL=
CODE_EXECUTION_API_KEY=

# 8. Runtime
NODE_ENV=development
PORT=3000
